<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>BasicsAdvancedTimer.Preview</AssemblyName>
    <RootNamespace>Timer.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(StorePackage)' == 'true'">
    <AssemblyName>BasicsAdvancedTimer</AssemblyName>
    <!-- Only the Store package uses Windows APIs (the startup task), so everyday builds and tests stay cross-platform. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DefineConstants>$(DefineConstants);STORE_PACKAGE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(BuildChannel)' == 'experimental'">
    <DefineConstants>$(DefineConstants);EXPERIMENTAL_BUILD</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(BuildChannel)' == 'alpha'">
    <DefineConstants>$(DefineConstants);ALPHA_BUILD</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/AppIcon.png" />
    <AvaloniaResource Include="Assets/Fonts/*.ttf" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BasicallyGod.Timer.Core" Version="$(SharedTimerVersion)" />
    <PackageReference Include="BasicallyGod.Timer.Storage" Version="$(SharedTimerVersion)" />
    <ProjectReference Include="../Timer.Desk/Timer.Desk.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
  </ItemGroup>
</Project>
