<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Timer.Desktop" x:Class="Timer.Desktop.App" RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Surface">#F5F8F4</SolidColorBrush>
          <SolidColorBrush x:Key="Panel">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="Ink">#24312B</SolidColorBrush>
          <SolidColorBrush x:Key="Muted">#68726C</SolidColorBrush>
          <SolidColorBrush x:Key="Line">#DDE5DC</SolidColorBrush>
          <SolidColorBrush x:Key="Hover">#E7EEE5</SolidColorBrush>
          <SolidColorBrush x:Key="Selected">#D9E9DA</SolidColorBrush>
          <SolidColorBrush x:Key="Live">#337A50</SolidColorBrush>
          <SolidColorBrush x:Key="Idle">#6D7471</SolidColorBrush>
          <SolidColorBrush x:Key="Overtime">#B83B3B</SolidColorBrush>
          <SolidColorBrush x:Key="BudgetWarning">#9D6C13</SolidColorBrush>
          <SolidColorBrush x:Key="Break">#B07A12</SolidColorBrush>
          <Color x:Key="ShadowColor">#59000000</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Surface">#1B221F</SolidColorBrush>
          <SolidColorBrush x:Key="Panel">#242D28</SolidColorBrush>
          <SolidColorBrush x:Key="Ink">#ECF2EC</SolidColorBrush>
          <SolidColorBrush x:Key="Muted">#ABB8AE</SolidColorBrush>
          <SolidColorBrush x:Key="Line">#3B493F</SolidColorBrush>
          <SolidColorBrush x:Key="Hover">#303D34</SolidColorBrush>
          <SolidColorBrush x:Key="Selected">#3B5542</SolidColorBrush>
          <SolidColorBrush x:Key="Live">#8FD7A3</SolidColorBrush>
          <SolidColorBrush x:Key="Idle">#ABB3AE</SolidColorBrush>
          <SolidColorBrush x:Key="Overtime">#FF9292</SolidColorBrush>
          <SolidColorBrush x:Key="BudgetWarning">#E8BD67</SolidColorBrush>
          <SolidColorBrush x:Key="Break">#F0C45A</SolidColorBrush>
          <Color x:Key="ShadowColor">#B3000000</Color>
        </ResourceDictionary>
        <!-- While a break is on, the whole app shifts to amber so it is obvious that no account is being timed.
             These are variants of Light and Dark, so everything not listed here is inherited. -->
        <ResourceDictionary x:Key="{x:Static local:TimerModel.BreakLight}">
          <SolidColorBrush x:Key="Surface">#FBF1D6</SolidColorBrush>
          <SolidColorBrush x:Key="Panel">#FFF8E5</SolidColorBrush>
          <SolidColorBrush x:Key="Ink">#3A2C0B</SolidColorBrush>
          <SolidColorBrush x:Key="Muted">#7A6A45</SolidColorBrush>
          <SolidColorBrush x:Key="Line">#EBDDB4</SolidColorBrush>
          <SolidColorBrush x:Key="Hover">#F4E6BC</SolidColorBrush>
          <SolidColorBrush x:Key="Selected">#F1DC9C</SolidColorBrush>
          <SolidColorBrush x:Key="Live">#337A50</SolidColorBrush>
          <SolidColorBrush x:Key="Idle">#8A7A50</SolidColorBrush>
          <SolidColorBrush x:Key="Overtime">#B83B3B</SolidColorBrush>
          <SolidColorBrush x:Key="BudgetWarning">#9D6C13</SolidColorBrush>
          <SolidColorBrush x:Key="Break">#B07A12</SolidColorBrush>
          <Color x:Key="ShadowColor">#59000000</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="{x:Static local:TimerModel.BreakDark}">
          <SolidColorBrush x:Key="Surface">#2A2314</SolidColorBrush>
          <SolidColorBrush x:Key="Panel">#342B18</SolidColorBrush>
          <SolidColorBrush x:Key="Ink">#F7EBCB</SolidColorBrush>
          <SolidColorBrush x:Key="Muted">#CDBB8E</SolidColorBrush>
          <SolidColorBrush x:Key="Line">#54482A</SolidColorBrush>
          <SolidColorBrush x:Key="Hover">#43381F</SolidColorBrush>
          <SolidColorBrush x:Key="Selected">#5E4D22</SolidColorBrush>
          <SolidColorBrush x:Key="Live">#8FD7A3</SolidColorBrush>
          <SolidColorBrush x:Key="Idle">#C7B684</SolidColorBrush>
          <SolidColorBrush x:Key="Overtime">#FF9292</SolidColorBrush>
          <SolidColorBrush x:Key="BudgetWarning">#E8BD67</SolidColorBrush>
          <SolidColorBrush x:Key="Break">#F0C45A</SolidColorBrush>
          <Color x:Key="ShadowColor">#B3000000</Color>
        </ResourceDictionary>
        <!-- Overtime turns the app red in the same way a break turns it amber. -->
        <ResourceDictionary x:Key="{x:Static local:TimerModel.OvertimeLight}">
          <SolidColorBrush x:Key="Surface">#FBEAE8</SolidColorBrush>
          <SolidColorBrush x:Key="Panel">#FFF4F2</SolidColorBrush>
          <SolidColorBrush x:Key="Ink">#3B1A18</SolidColorBrush>
          <SolidColorBrush x:Key="Muted">#7D5A57</SolidColorBrush>
          <SolidColorBrush x:Key="Line">#EBCFCB</SolidColorBrush>
          <SolidColorBrush x:Key="Hover">#F4D9D5</SolidColorBrush>
          <SolidColorBrush x:Key="Selected">#F0C9C4</SolidColorBrush>
          <SolidColorBrush x:Key="Live">#337A50</SolidColorBrush>
          <SolidColorBrush x:Key="Idle">#8A6F6B</SolidColorBrush>
          <SolidColorBrush x:Key="Overtime">#B83B3B</SolidColorBrush>
          <SolidColorBrush x:Key="BudgetWarning">#9D6C13</SolidColorBrush>
          <SolidColorBrush x:Key="Break">#B07A12</SolidColorBrush>
          <Color x:Key="ShadowColor">#59000000</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="{x:Static local:TimerModel.OvertimeDark}">
          <SolidColorBrush x:Key="Surface">#2B1A19</SolidColorBrush>
          <SolidColorBrush x:Key="Panel">#352220</SolidColorBrush>
          <SolidColorBrush x:Key="Ink">#F7E1DE</SolidColorBrush>
          <SolidColorBrush x:Key="Muted">#D0AEAA</SolidColorBrush>
          <SolidColorBrush x:Key="Line">#54332F</SolidColorBrush>
          <SolidColorBrush x:Key="Hover">#432926</SolidColorBrush>
          <SolidColorBrush x:Key="Selected">#5E302B</SolidColorBrush>
          <SolidColorBrush x:Key="Live">#8FD7A3</SolidColorBrush>
          <SolidColorBrush x:Key="Idle">#C9A8A4</SolidColorBrush>
          <SolidColorBrush x:Key="Overtime">#FF9292</SolidColorBrush>
          <SolidColorBrush x:Key="BudgetWarning">#E8BD67</SolidColorBrush>
          <SolidColorBrush x:Key="Break">#F0C45A</SolidColorBrush>
          <Color x:Key="ShadowColor">#B3000000</Color>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="ScrollBar">
      <Setter Property="Theme">
        <ControlTheme TargetType="ScrollBar">
          <Setter Property="Template">
        <ControlTemplate>
          <Track Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value, Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}"
                 Orientation="{TemplateBinding Orientation}">
            <Track.Thumb>
              <Thumb Name="PART_Thumb">
                <Thumb.Template>
                  <ControlTemplate>
                    <Border Background="{DynamicResource Muted}" CornerRadius="3" Margin="1" Opacity="0.55" />
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
          </Track>
        </ControlTemplate>
          </Setter>
        </ControlTheme>
      </Setter>
    </Style>
    <Style Selector="ScrollBar:vertical">
      <Setter Property="Width" Value="8" /><Setter Property="MinWidth" Value="8" /><Setter Property="MaxWidth" Value="8" />
    </Style>
    <Style Selector="ScrollBar:vertical /template/ Thumb"><Setter Property="MinHeight" Value="24" /><Setter Property="MinWidth" Value="6" /></Style>
    <Style Selector="ScrollBar:vertical /template/ Track"><Setter Property="IsDirectionReversed" Value="True" /></Style>
    <Style Selector="ScrollBar:horizontal">
      <Setter Property="Height" Value="8" /><Setter Property="MinHeight" Value="8" /><Setter Property="MaxHeight" Value="8" />
    </Style>
    <Style Selector="ScrollBar:horizontal /template/ Thumb"><Setter Property="MinHeight" Value="6" /><Setter Property="MinWidth" Value="24" /></Style>
    <Style Selector="Window">
      <!-- Fixed-width digits, so a clock or total does not shift its neighbours as the numbers change. -->
      <Setter Property="TextElement.FontFeatures" Value="tnum" />
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Ink}" /></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource Muted}" /></Style>
    <Style Selector="TextBlock.idle"><Setter Property="Foreground" Value="{DynamicResource Idle}" /></Style>
    <Style Selector="TextBlock.live"><Setter Property="Foreground" Value="{DynamicResource Live}" /></Style>
    <Style Selector="TextBlock.break"><Setter Property="Foreground" Value="{DynamicResource Break}" /></Style>
    <Style Selector="TextBlock.overtime"><Setter Property="Foreground" Value="{DynamicResource Overtime}" /></Style>
    <Style Selector="Border.surface"><Setter Property="Background" Value="{DynamicResource Surface}" /></Style>
    <Style Selector="Border.panel"><Setter Property="Background" Value="{DynamicResource Panel}" /></Style>
    <Style Selector="Border.rule"><Setter Property="Background" Value="{DynamicResource Line}" /></Style>
    <Style Selector="Button">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource Panel}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Hover}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <Style Selector="Border.mergeSelected">
      <Setter Property="BorderThickness" Value="3" />
      <Setter Property="BorderBrush" Value="{DynamicResource Ink}" />
    </Style>
    <Style Selector="Border#DayProgressFill"><Setter Property="Background" Value="{DynamicResource Live}" /></Style>
    <Style Selector="Border#DayProgressFill.progressOvertime"><Setter Property="Background" Value="{DynamicResource Overtime}" /></Style>
    <Style Selector="Border#DayProgressFill.progressBreak"><Setter Property="Background" Value="{DynamicResource Break}" /></Style>
    <Style Selector="Border.recording">
      <Setter Property="BorderThickness" Value="3" />
      <Setter Property="BorderBrush" Value="{DynamicResource Live}" />
    </Style>
    <Style Selector="Button.mergeSelected">
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{DynamicResource Ink}" />
      <Setter Property="Background" Value="{DynamicResource Selected}" />
    </Style>
    <Style Selector="Button.account">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Height" Value="68" />
      <Setter Property="Padding" Value="16,8" />
    </Style>
    <Style Selector="Button.account.active">
      <Setter Property="Background" Value="{DynamicResource Selected}" />
    </Style>
    <Style Selector="Button.tab.selected">
      <Setter Property="Background" Value="{DynamicResource Selected}" />
    </Style>
    <Style Selector="Button.pillAction">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Height" Value="52" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.round">
      <Setter Property="CornerRadius" Value="24" />
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="0" />
    </Style>
  </Application.Styles>
</Application>
