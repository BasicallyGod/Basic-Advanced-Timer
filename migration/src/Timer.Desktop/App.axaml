<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Timer.Desktop" x:Class="Timer.Desktop.App" RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <!-- The colours come from the theme engine (ThemeEngine.cs), which registers a dictionary for every theme and its break and overtime tints. -->
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <!-- The colour picker is a separate package whose look is not part of FluentTheme. -->
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    <Style Selector="ScrollBar">
      <Setter Property="Theme">
        <ControlTheme TargetType="ScrollBar">
          <Setter Property="Template">
        <ControlTemplate>
          <Track Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value, Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}"
                 Orientation="{TemplateBinding Orientation}">
            <Track.Thumb>
              <Thumb Name="PART_Thumb">
                <Thumb.Template>
                  <ControlTemplate>
                    <Border Name="ThumbFill" Background="{DynamicResource ScrollThumb}" CornerRadius="4" />
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
          </Track>
        </ControlTemplate>
          </Setter>
        </ControlTheme>
      </Setter>
    </Style>
    <Style Selector="ScrollBar:vertical">
      <Setter Property="Width" Value="10" /><Setter Property="MinWidth" Value="10" /><Setter Property="MaxWidth" Value="10" />
    </Style>
    <Style Selector="ScrollBar:vertical /template/ Thumb"><Setter Property="MinHeight" Value="24" /><Setter Property="MinWidth" Value="8" /></Style>
    <!-- Scroll bars stay out of sight until the pointer is over the area they belong to, so they never distract from the content. -->
    <Style Selector="ScrollViewer ScrollBar">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.18" /></Transitions></Setter>
    </Style>
    <Style Selector="ScrollViewer:pointerover ScrollBar"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="ScrollBar:vertical /template/ Track"><Setter Property="IsDirectionReversed" Value="True" /></Style>
    <Style Selector="ScrollBar:horizontal">
      <Setter Property="Height" Value="10" /><Setter Property="MinHeight" Value="10" /><Setter Property="MaxHeight" Value="10" />
    </Style>
    <Style Selector="ScrollBar:horizontal /template/ Thumb"><Setter Property="MinHeight" Value="8" /><Setter Property="MinWidth" Value="24" /></Style>
    <!-- At rest the thumb is a thin 4 pixel line in the middle of its 10 pixel track, and it thickens to 8 when the pointer is on the bar, so it is felt but not seen. The margin is set here and not
         in the template, because a value set in the template would beat these. -->
    <Style Selector="ScrollBar:vertical /template/ Thumb /template/ Border#ThumbFill"><Setter Property="Margin" Value="3,1" /><Setter Property="Transitions"><Transitions><ThicknessTransition Property="Margin" Duration="0:0:0.12" /></Transitions></Setter></Style>
    <Style Selector="ScrollBar:horizontal /template/ Thumb /template/ Border#ThumbFill"><Setter Property="Margin" Value="1,3" /><Setter Property="Transitions"><Transitions><ThicknessTransition Property="Margin" Duration="0:0:0.12" /></Transitions></Setter></Style>
    <Style Selector="ScrollBar:pointerover /template/ Thumb /template/ Border#ThumbFill"><Setter Property="Margin" Value="1" /></Style>
    <!-- The thumb is a quiet grey that darkens under the pointer, on a transparent track. -->
    <Style Selector="ScrollBar /template/ Thumb:pointerover /template/ Border#ThumbFill"><Setter Property="Background" Value="{DynamicResource ScrollThumbHover}" /></Style>
    <Style Selector="Window">
      <!-- Fixed-width digits, so a clock or total does not shift its neighbours as the numbers change. -->
      <Setter Property="TextElement.FontFeatures" Value="tnum" />
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Ink}" /></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource Muted}" /></Style>
    <!-- The clock is the main thing on the screen, so when nothing is running it is full-strength text rather than the dim idle grey. -->
    <!-- Clocks and the big numbers use Bricolage Grotesque, in instances cut from its variable font so each weight is its own family. -->
    <Style Selector="TextBlock.clock">
      <Setter Property="FontFamily" Value="{DynamicResource ClockFont}" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="TextBlock.clockLight">
      <Setter Property="FontFamily" Value="{DynamicResource ClockLightFont}" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="TextBlock.figures">
      <Setter Property="FontFamily" Value="{DynamicResource FiguresFont}" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="TextBlock.clockIdle"><Setter Property="Foreground" Value="{DynamicResource Clock}" /></Style>
    <Style Selector="TextBlock.idle"><Setter Property="Foreground" Value="{DynamicResource Idle}" /></Style>
    <Style Selector=":is(Border).selectionStrip"><Setter Property="Background" Value="{DynamicResource Panel}" /><Setter Property="BorderBrush" Value="{DynamicResource Line}" /></Style>
    <Style Selector="Border.scrollEdge"><Setter Property="Background" Value="{DynamicResource Line}" /></Style>
    <Style Selector="Ellipse.stepDot"><Setter Property="Fill" Value="{DynamicResource Accent}" /></Style>
    <Style Selector="Ellipse.live"><Setter Property="Fill" Value="{DynamicResource Live}" /></Style>
    <Style Selector="Ellipse.break"><Setter Property="Fill" Value="{DynamicResource Break}" /></Style>
    <Style Selector="Ellipse.idle"><Setter Property="Fill" Value="{DynamicResource Idle}" /></Style>
    <Style Selector="TextBlock.live"><Setter Property="Foreground" Value="{DynamicResource Live}" /></Style>
    <Style Selector="TextBlock.break"><Setter Property="Foreground" Value="{DynamicResource Break}" /></Style>
    <Style Selector="Border.budgetFill"><Setter Property="Background" Value="{DynamicResource Muted}" /></Style>
    <Style Selector="Border.budgetFill.budgetWarn"><Setter Property="Background" Value="{DynamicResource BudgetWarning}" /></Style>
    <Style Selector="Border.budgetFill.budgetOver"><Setter Property="Background" Value="{DynamicResource Overtime}" /></Style>
    <Style Selector="TextBlock.budgetWarning"><Setter Property="Foreground" Value="{DynamicResource BudgetWarningText}" /></Style>
    <Style Selector="TextBlock.overtime"><Setter Property="Foreground" Value="{DynamicResource Overtime}" /></Style>
    <Style Selector="Border.surface"><Setter Property="Background" Value="{DynamicResource Surface}" /></Style>
    <Style Selector=":is(Border).flyoutCard"><Setter Property="Background" Value="{DynamicResource Panel}" /><Setter Property="BorderBrush" Value="{DynamicResource Line}" /></Style>
    <!-- Tooltips are the app's own card: the panel colour, a hairline, rounded, with the action in a word or two and a shortcut as a small key. -->
    <Style Selector="ToolTip"><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="9,5" /><Setter Property="FontSize" Value="12.5" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="BorderThickness" Value="1" /><Setter Property="MaxWidth" Value="320" /></Style>
    <Style Selector="Border.tipKey"><Setter Property="BorderBrush" Value="{DynamicResource Line}" /></Style>
    <Style Selector="Border.tipKey TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}" /></Style>
    <Style Selector="Border.pillBody"><Setter Property="Background" Value="{DynamicResource PillBody}" /></Style>
    <Style Selector="Border.panel"><Setter Property="Background" Value="{DynamicResource Panel}" /></Style>
    <Style Selector="Border.rule"><Setter Property="Background" Value="{DynamicResource Line}" /></Style>
    <Style Selector="Button">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource Panel}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Hover}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <!-- Right-click menus: rounded, with a little room round the items, in the theme's colours (ThemeEngine writes the menu resources). -->
    <Style Selector="ContextMenu"><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="6" /></Style>
    <Style Selector="ContextMenu MenuItem"><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="10,7" /><Setter Property="FontSize" Value="13" /></Style>
    <!-- Fields: rounded, as the mock draws them (ThemeEngine writes their fill, hairline and focus colours). -->
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="11" /></Style>
    <Style Selector="ComboBox"><Setter Property="CornerRadius" Value="12" /></Style>
    <Style Selector="Button.softDay:disabled"><Setter Property="Opacity" Value="0.35" /></Style>
    <!-- Notes: the chips (an accent one for a reminder, a red one once it is late), the rows, the round tick and the form's box. -->
    <Style Selector="Border.lateRow"><Setter Property="Background" Value="{DynamicResource LateTint}" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
    <!-- The Notes page: the views down the left, a row being changed, the rule under the form and the form's accent-edged box. -->
    <Style Selector="Button.weekDay"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="12" /></Style>
    <!-- No fill under the pointer or the press: a day's column would hide the schedule line and hour lines behind it. -->
    <Style Selector="Button.weekDay /template/ ContentPresenter, Button.weekDay:pointerover /template/ ContentPresenter, Button.weekDay:pressed /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.vitem"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="10,7" /></Style>
    <Style Selector="Button.vitem /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.vitem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource Hover}" /></Style>
    <Style Selector="Button.vitem.vitemOn /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource Selected}" /></Style>
    <Style Selector="Border.rowSelected"><Setter Property="BorderBrush" Value="{DynamicResource Accent}" /><Setter Property="BorderThickness" Value="3,1,1,1" /></Style>
    <Style Selector="Border.ruleBelow"><Setter Property="BorderBrush" Value="{DynamicResource Line}" /></Style>
    <Style Selector="TextBox.accentField"><Setter Property="BorderBrush" Value="{DynamicResource Accent}" /></Style>
    <Style Selector="TextBox.accentField /template/ Border#PART_BorderElement, TextBox.accentField:pointerover /template/ Border#PART_BorderElement, TextBox.accentField:focus /template/ Border#PART_BorderElement"><Setter Property="BorderBrush" Value="{DynamicResource Accent}" /></Style>
    <Style Selector="Border.badge"><Setter Property="Background" Value="{DynamicResource Overtime}" /></Style>
    <Style Selector="Border.accentChip"><Setter Property="Background" Value="{DynamicResource Selected}" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
    <Style Selector="Border.lateChip"><Setter Property="Background" Value="{DynamicResource LateTint}" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
    <Style Selector="Border.noteRow"><Setter Property="Background" Value="{DynamicResource Panel}" /><Setter Property="BorderBrush" Value="{DynamicResource Line}" /></Style>
    <Style Selector="Border.tick"><Setter Property="BorderBrush" Value="{DynamicResource Muted}" /></Style>
    <Style Selector="Border.tick.tickDone"><Setter Property="Background" Value="{DynamicResource Accent}" /><Setter Property="BorderBrush" Value="{DynamicResource Accent}" /></Style>
    <Style Selector="Border.composer"><Setter Property="Background" Value="{DynamicResource TextControlBackground}" /><Setter Property="BorderBrush" Value="{DynamicResource Accent}" /></Style>
    <Style Selector="TextBox.bareField, TextBox.bareField:pointerover, TextBox.bareField:focus"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
    <Style Selector="TextBox.bareField /template/ Border#PART_BorderElement, TextBox.bareField:pointerover /template/ Border#PART_BorderElement, TextBox.bareField:focus /template/ Border#PART_BorderElement"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
    <!-- Planned meetings on the timeline: dashed cards (the frame is a dashed rectangle, since a border cannot be dashed), and the row they sit in. -->
    <Style Selector="Rectangle.meetingFrame"><Setter Property="Stroke" Value="{DynamicResource MeetLine}" /><Setter Property="Fill" Value="{DynamicResource MeetBg}" /></Style>
    <Style Selector="Rectangle.meetingFrame.over"><Setter Property="Fill" Value="{DynamicResource Selected}" /></Style>
    <Style Selector="Border.meetingLane.over"><Setter Property="Background" Value="{DynamicResource MeetBg}" /></Style>
    <Style Selector="Border.plainChip"><Setter Property="Background" Value="{DynamicResource Surface}" /></Style>
    <Style Selector="Border.selectedRow"><Setter Property="Background" Value="{DynamicResource Surface}" /><Setter Property="BorderBrush" Value="{DynamicResource Line}" /></Style>
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{DynamicResource Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    </Style>
    <!-- The left side has no border, because the block's coloured strip is its left edge and a border beside it looked like interference. -->
    <!-- The dim layer behind a dialog, in the theme's shadow colour. -->
    <Style Selector="Border.scrim"><Setter Property="Background" Value="{DynamicResource ShadowColor}" /></Style>
    <!-- A selected block is shown by its left strip, in the accent colour, and not by an outline. The class stays on the block so it can be found. -->
    <Style Selector="Border.selectedEdge"><Setter Property="Background" Value="{DynamicResource Accent}" /></Style>
    <Style Selector="Border#DayProgressFill"><Setter Property="Background" Value="{DynamicResource Accent}" /></Style>
    <!-- On a break the whole pill is that colour, so the bar is drawn in the pill's text colour. -->
    <Style Selector="Border#DayProgressFill.progressBreak"><Setter Property="Background" Value="{DynamicResource Ink}" /></Style>
    <!-- The now marker on today's timeline is drawn in the accent colour, with its chip's text in the accent's own text colour. -->
    <!-- The bar of the scheduled day under the timeline: time on accounts in a neutral, breaks in amber, on a quiet track. -->
    <Style Selector="Border.track"><Setter Property="Background" Value="{DynamicResource Hover}" /></Style>
    <Style Selector="Border.barAllocated"><Setter Property="Background" Value="{DynamicResource Muted}" /></Style>
    <Style Selector="Border.barBreaks"><Setter Property="Background" Value="{DynamicResource Break}" /></Style>
    <Style Selector="Border.nowLine"><Setter Property="Background" Value="{DynamicResource Accent}" /></Style>
    <Style Selector="Ellipse.nowDot"><Setter Property="Fill" Value="{DynamicResource Accent}" /><Setter Property="Stroke" Value="{DynamicResource Surface}" /><Setter Property="StrokeThickness" Value="2" /></Style>
    <Style Selector="Border.nowChip"><Setter Property="Background" Value="{DynamicResource Accent}" /></Style>
    <Style Selector="TextBlock.nowChipText"><Setter Property="Foreground" Value="{DynamicResource AccentInk}" /></Style>
    <Style Selector="Button.mergeSelected">
      <Setter Property="Background" Value="{DynamicResource Selected}" />
    </Style>
    <Style Selector="Button.account">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Height" Value="52" />
      <Setter Property="Padding" Value="16,6" />
    </Style>
    <!-- A row of the Entries view: flat, rounded, and lit by the hover colour like the account rows. -->
    <Style Selector="Button.entryRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="52" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.account.active">
      <Setter Property="Background" Value="{DynamicResource Selected}" />
    </Style>
    <!-- The dashboard's account rows are soft rounded cards. The recording account's card takes a gentle tint of the tracking colour. -->
    <Style Selector="Button.accountCard"><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="10,6" /></Style>
    <Style Selector="Button.accountCard:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Hover}" /></Style>
    <Style Selector="Button.accountCard.active"><Setter Property="Background" Value="{DynamicResource LiveTint}" /></Style>
    <Style Selector="Button.accountCard.active /template/ ContentPresenter#PART_ContentPresenter, Button.accountCard.active:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource LiveTint}" /></Style>
    <!-- The rail's icons sit in soft tiles. The chosen one is filled, and the rest are muted until the pointer arrives. -->
    <Style Selector="Button.rail">
      <Setter Property="Width" Value="44" /><Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <!-- Every state is written out, and there is no fade: the standard button's own bright hover colour showed for a moment as the pointer arrived, before the fade settled on the chosen tile's colour. -->
    <Style Selector="Button.rail:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.rail:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Hover}" />
    </Style>
    <Style Selector="Button.rail.selected /template/ ContentPresenter#PART_ContentPresenter, Button.rail.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.rail.selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Selected}" />
    </Style>
    <!-- The close icon stays still, with the same soft hover surface as the other rail controls. -->
    <Style Selector="Button.quit:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Hover}" /></Style>
    <Style Selector="Button.iconButton /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.2" /></Transitions></Setter>
    </Style>
    <!-- The floating message is the tooltips' card, a little larger: the panel colour, a hairline and a soft shadow, so it is easy to see against any block. -->
    <Style Selector=":is(Border).messageBar">
      <Setter Property="Background" Value="{DynamicResource Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="0 6 18 0 #29141E46" />
    </Style>
    <!-- A failed save stays until a save works, so its edge is heavier. -->
    <Style Selector=":is(Border).messageBar.hold"><Setter Property="BorderBrush" Value="{DynamicResource Ink}" /><Setter Property="BorderThickness" Value="1.5" /></Style>
    <Style Selector="Border.okIcon"><Setter Property="Background" Value="{DynamicResource Selected}" /></Style>
    <Style Selector="Border.warnIcon"><Setter Property="BorderBrush" Value="{DynamicResource Ink}" /><Setter Property="BorderThickness" Value="1.6" /></Style>
    <!-- The Day elapsed card is a raised tile with a bar of the accent colour along its top edge. -->
    <Style Selector=":is(Border).dayCard">
      <Setter Property="Background" Value="{DynamicResource Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    </Style>
    <!-- Small custom date picker: no system Calendar's heavy ruled grid or bright blue selection. -->
    <Style Selector="Border.softCalendar">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    </Style>
    <Style Selector="Button.softDay">
      <Setter Property="Width" Value="33" /><Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.softDay /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.softDay:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Hover}" />
    </Style>
    <Style Selector="Button.softDay.outsideMonth"><Setter Property="Opacity" Value="0.42" /></Style>
    <Style Selector="Button.softDay.chosenDay /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Selected}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <Style Selector="Button.softDay.todayDay /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="BorderThickness" Value="1.3" />
    </Style>
    <!-- The calendar in the date pickers: soft round days, the accent for the chosen one, no grey blocks (the rest comes from the Calendar resources ThemeEngine writes). -->
    <Style Selector="CalendarDayButton"><Setter Property="CornerRadius" Value="8" /><Setter Property="Margin" Value="1" /></Style>
    <Style Selector="CalendarDayButton:selected"><Setter Property="Background" Value="{DynamicResource Selected}" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="FontWeight" Value="Bold" /></Style>
    <Style Selector="CalendarDayButton:selected /template/ Border#Root"><Setter Property="Background" Value="{DynamicResource Selected}" /></Style>
    <Style Selector="CalendarDayButton:today"><Setter Property="Background" Value="{DynamicResource Accent}" /><Setter Property="Foreground" Value="{DynamicResource AccentInk}" /></Style>
    <Style Selector="CalendarDayButton:today /template/ TextBlock"><Setter Property="Foreground" Value="{DynamicResource AccentInk}" /></Style>
    <Style Selector="CalendarDayButton:today /template/ Border#Root"><Setter Property="Background" Value="{DynamicResource Accent}" /></Style>
    <Style Selector="CalendarItem /template/ Button"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /></Style>
    <Style Selector="Border.accentEdge"><Setter Property="Background" Value="{DynamicResource Accent}" /></Style>
    <!-- A button that cannot be used keeps the outlined look, only dimmer, so it never outshines the ones that can. -->
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    </Style>
    <Style Selector="Button:disabled"><Setter Property="Opacity" Value="0.55" /></Style>
    <Style Selector="Button.pillAction">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Height" Value="52" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <!-- The break button wears the break colour, so it reads as its own function beside the account buttons. -->
    <Style Selector="Button.breakButton">
      <Setter Property="BorderBrush" Value="{DynamicResource Break}" />
      <Setter Property="Foreground" Value="{DynamicResource Break}" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>
    <Style Selector="Button.breakButton.onBreak">
      <Setter Property="Background" Value="{DynamicResource Break}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.breakButton.onBreak:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Break}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.breakButton.onBreak TextBlock"><Setter Property="Foreground" Value="White" /></Style>
    <!-- The main action of a window, filled so it is the first thing the eye finds. -->
    <!-- Finishing the day is red. The colour is the Finish theme name, so each theme can set its own. -->
    <Style Selector="Button.finishDay">
      <Setter Property="Background" Value="{DynamicResource Finish}" />
      <Setter Property="Foreground" Value="{DynamicResource Surface}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.finishDay:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Finish}" />
      <Setter Property="Foreground" Value="{DynamicResource Surface}" />
      <Setter Property="Opacity" Value="0.88" />
    </Style>
    <Style Selector="Button.finishDay.outlined">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Finish}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Finish}" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>
    <Style Selector="Button.finishDay.outlined:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Hover}" />
      <Setter Property="Foreground" Value="{DynamicResource Finish}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- Starting the day is green: the same outlined button as Finish day, in the live colour. -->
    <Style Selector="Button.startDay">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Start}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Start}" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>
    <Style Selector="Button.startDay:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Hover}" />
      <Setter Property="Foreground" Value="{DynamicResource Start}" />
    </Style>
    <!-- The dashboard's break and day buttons rest with a quiet outline and take on their own colour when the pointer is over them. Their icons keep their colour either way. -->
    <Style Selector="Button.quiet.breakButton, Button.quiet.finishDay.outlined, Button.quiet.startDay">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>
    <Style Selector="Button.quiet.breakButton:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Hover}" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="BorderBrush" Value="{DynamicResource Break}" />
    </Style>
    <Style Selector="Button.quiet.finishDay.outlined:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Hover}" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="BorderBrush" Value="{DynamicResource Finish}" />
    </Style>
    <Style Selector="Button.quiet.startDay:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Hover}" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="BorderBrush" Value="{DynamicResource Start}" />
    </Style>
    <!-- A plain text button, for quiet actions such as Skip setup. -->
    <!-- The pill's buttons draw their own faces (a circle, a tile), so the button itself has no background, border or hover of its own. -->
    <Style Selector="Button.pillBare"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="FocusAdorner" Value="{x:Null}" /></Style>
    <!-- A link in a note: the accent, underlined under the pointer. The words are set on the text itself, since the global text style would beat the button's colour. -->
    <Style Selector="Button.noteLink TextBlock"><Setter Property="Foreground" Value="{DynamicResource AccentText}" /></Style>
    <Style Selector="Button.noteLink:pointerover TextBlock"><Setter Property="TextDecorations" Value="Underline" /></Style>
    <Style Selector="Button.pillBare:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.pillBare:pressed /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.peekAll"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Foreground" Value="{DynamicResource Accent}" /><Setter Property="Padding" Value="8,6" /><Setter Property="FontSize" Value="13" /></Style>
    <Style Selector="Button.peekAll:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource Hover}" /></Style>
    <Style Selector="Button.flat"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Foreground" Value="{DynamicResource Muted}" /><Setter Property="Padding" Value="8,4" /></Style>
    <!-- The offered account the arrow keys have reached, as the hovered one looks, so keyboard and pointer read alike. -->
    <Style Selector="Button.flat.suggestOn /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource Selected}" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /></Style>
    <Style Selector="Button.flat:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource Hover}" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /></Style>
    <!-- The two big choices in the getting started setup. The chosen one has an accent border and the selection tint. -->
    <Style Selector="Button.choiceTile">
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="{DynamicResource Line}" /><Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="CornerRadius" Value="14" /><Setter Property="Padding" Value="18,14" /><Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <Style Selector="Button.choiceTile:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource Hover}" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /></Style>
    <Style Selector="Button.choiceTile.selected /template/ ContentPresenter, Button.choiceTile.selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Selected}" /><Setter Property="BorderBrush" Value="{DynamicResource Accent}" /><Setter Property="BorderThickness" Value="2" />
    </Style>
    <!-- The section list on the settings page: quiet rows, and the chosen one in the selection tint with the accent for its words. -->
    <Style Selector="Button.settingsNav">
      <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="12,9" /><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.settingsNav:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource Hover}" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /></Style>
    <Style Selector="Button.settingsNav.selected /template/ ContentPresenter, Button.settingsNav.selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Selected}" /><Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Button.settingsNav.selected"><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <!-- A theme picture keeps its own colours, so a chosen one shows by its accent border alone. -->
    <Style Selector="Button.choiceTile.themeTile.selected /template/ ContentPresenter, Button.choiceTile.themeTile.selected:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <!-- The dashboard's buttons (the date arrows, Today, the gear, Add time, Undo, zoom and the Selected block card's actions): a card with a hairline, as drawn in the mock. -->
    <Style Selector="Button.ctl">
      <Setter Property="Background" Value="{DynamicResource Panel}" /><Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="12,0" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="FontSize" Value="14" />
      <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.ctl:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Hover}" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    </Style>
    <Style Selector="Button.ctl:disabled"><Setter Property="Opacity" Value="0.5" /></Style>
    <Style Selector="Button.ctl.small"><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="11,0" /><Setter Property="FontSize" Value="13" /></Style>
    <Style Selector="Button.ctl.accentOutline"><Setter Property="BorderBrush" Value="{DynamicResource Accent}" /><Setter Property="Foreground" Value="{DynamicResource Accent}" /></Style>
    <Style Selector="Button.ctl.accentOutline:pointerover /template/ ContentPresenter"><Setter Property="BorderBrush" Value="{DynamicResource Accent}" /><Setter Property="Foreground" Value="{DynamicResource Accent}" /></Style>
    <Style Selector="Button.ctl.primary"><Setter Property="Background" Value="{DynamicResource Accent}" /><Setter Property="Foreground" Value="{DynamicResource AccentInk}" /><Setter Property="BorderBrush" Value="{DynamicResource Accent}" /></Style>
    <!-- The global TextBlock style gives every text the Ink colour, which beats what the button hands down, so a primary button's words are set here: white on the Light accent, where Ink was a dark grey on blue. -->
    <Style Selector="Button.ctl.primary TextBlock"><Setter Property="Foreground" Value="{DynamicResource AccentInk}" /></Style>
    <Style Selector="Button.ctl.primary /template/ ContentPresenter, Button.ctl.primary:pressed /template/ ContentPresenter, Button.ctl.primary:disabled /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource Accent}" /><Setter Property="Foreground" Value="{DynamicResource AccentInk}" /><Setter Property="BorderBrush" Value="{DynamicResource Accent}" /></Style>
    <Style Selector="Button.ctl.primary:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource Accent}" /><Setter Property="Foreground" Value="{DynamicResource AccentInk}" /><Setter Property="BorderBrush" Value="{DynamicResource Accent}" /><Setter Property="Opacity" Value="0.92" /></Style>
    <Style Selector="Button.ctl.on"><Setter Property="Background" Value="{DynamicResource Selected}" /><Setter Property="Foreground" Value="{DynamicResource AccentText}" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
    <Style Selector="Button.ctl.on:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource Selected}" /><Setter Property="Foreground" Value="{DynamicResource AccentText}" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
    <!-- Round option chips (the reminder pop-up's quick days and times): a soft fill, and the accent when chosen. -->
    <Style Selector="Button.ctl.pillOpt"><Setter Property="CornerRadius" Value="999" /><Setter Property="Background" Value="{DynamicResource Surface}" /></Style>
    <Style Selector="Button.ctl.pillOpt.optOn"><Setter Property="Background" Value="{DynamicResource Accent}" /><Setter Property="Foreground" Value="{DynamicResource AccentInk}" /><Setter Property="BorderBrush" Value="{DynamicResource Accent}" /></Style>
    <Style Selector="Button.ctl.pillOpt.optOn:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource Accent}" /><Setter Property="Foreground" Value="{DynamicResource AccentInk}" /><Setter Property="BorderBrush" Value="{DynamicResource Accent}" /></Style>
    <!-- A two-way switch (Note or Meeting, Chart or Table): one rounded track holding the choices, the chosen one filled with the accent, so it reads as a single control with one answer. -->
    <Style Selector="Border.segTrack"><Setter Property="Background" Value="{DynamicResource Surface}" /><Setter Property="BorderBrush" Value="{DynamicResource Line}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="999" /><Setter Property="Padding" Value="3" /></Style>
    <Style Selector="Button.seg"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="999" /><Setter Property="Padding" Value="15,0" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="Foreground" Value="{DynamicResource Muted}" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style Selector="Button.seg /template/ ContentPresenter, Button.seg:pressed /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource Muted}" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="Button.seg:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource Hover}" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /></Style>
    <Style Selector="Button.seg.optOn /template/ ContentPresenter, Button.seg.optOn:pointerover /template/ ContentPresenter, Button.seg.optOn:pressed /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource Accent}" /><Setter Property="Foreground" Value="{DynamicResource AccentInk}" /></Style>
    <!-- Add time, Undo and Merge use the same resting outline as the break and day buttons, and light up their border under the pointer. -->
    <Style Selector="Button.toolButton">
      <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" /><Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="Padding" Value="14,0" /><Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.toolButton:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Hover}" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="BorderBrush" Value="{DynamicResource Ink}" />
    </Style>
    <Style Selector="Button.toolButton.addButton:pointerover /template/ ContentPresenter"><Setter Property="BorderBrush" Value="{DynamicResource Accent}" /></Style>
    <!-- Buttons in dialogs: the same outline, a little more room, and an accent outline on the main action. -->
    <Style Selector="Button.toolButton.dialogButton"><Setter Property="MinHeight" Value="36" /><Setter Property="Padding" Value="16,0" /><Setter Property="FontSize" Value="14" /></Style>
    <Style Selector="Button.toolButton.mainAction"><Setter Property="BorderBrush" Value="{DynamicResource Accent}" /></Style>
    <Style Selector="Button.toolButton.mainAction:pointerover /template/ ContentPresenter"><Setter Property="BorderBrush" Value="{DynamicResource Accent}" /></Style>
    <Style Selector="Button.quiet.breakButton.onBreak">
      <Setter Property="Background" Value="{DynamicResource Break}" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderBrush" Value="{DynamicResource Break}" />
    </Style>
    <Style Selector="Button.quiet.breakButton.onBreak:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Break}" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderBrush" Value="{DynamicResource Break}" />
    </Style>
    <!-- Lists take the theme's colours, so a chosen row reads as chosen in every theme. -->
    <Style Selector="ListBox"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Hover}" /></Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Selected}" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /></Style>
    <Style Selector="Button.iconButton">
      <Setter Property="Width" Value="32" /><Setter Property="Height" Value="30" /><Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.iconButton:disabled"><Setter Property="Opacity" Value="0.4" /></Style>
  </Application.Styles>
</Application>
