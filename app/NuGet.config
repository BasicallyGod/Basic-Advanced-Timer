<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Timer.Core and Timer.Storage live in the Basic-Timer-Core repository and are published to GitHub Packages. Reading them needs a token with
       read:packages in the PACKAGES_TOKEN environment variable (a repository secret in CI). Everything else still comes from nuget.org. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="basic-timer" value="https://nuget.pkg.github.com/BasicallyGod/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
    <packageSource key="basic-timer"><package pattern="BasicallyGod.*" /></packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <basic-timer>
      <add key="Username" value="BasicallyGod" />
      <add key="ClearTextPassword" value="%PACKAGES_TOKEN%" />
    </basic-timer>
  </packageSourceCredentials>
</configuration>
